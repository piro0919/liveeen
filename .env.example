# .env.local に写して使う（.env.local はコミットしない）。本番の値は Vercel の環境変数にある（CLAUDE.md）
# 空のままでよいものは、その機能が止まるだけ（src/env.ts）

# 手元の DB（compose.yaml。pnpm db:up）
DATABASE_URL=postgres://liveeen:liveeen@localhost:5435/liveeen
# 手元の配信サーバー（compose.yaml の MediaMTX）
NEXT_PUBLIC_MEDIA_RTMP_URL=rtmp://localhost:1935
NEXT_PUBLIC_MEDIA_WEBRTC_URL=http://localhost:8889
NEXT_PUBLIC_MEDIA_HLS_URL=http://localhost:8888
MEDIA_API_URL=http://localhost:9997
# 本番だけ。Caddy が MediaMTX の API の前で確かめる値（配信サーバーの deploy/.env と同じ）
MEDIA_API_SECRET=

# ログイン（Better Auth）。秘密の値は 32 文字以上（openssl rand -hex 32 など）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ブラウザの配信の10分の札
MEDIA_TOKEN_SECRET=

# コメントの中継（pnpm relay）。COMMENT_TOKEN_SECRET は中継と同じ値
NEXT_PUBLIC_COMMENT_RELAY_URL=ws://localhost:8090
COMMENT_TOKEN_SECRET=

# 管理画面を開ける人のメールアドレス（カンマ区切り）。通報の知らせもここへ送る
ADMIN_EMAILS=

# ブラウザ通知（Web Push）。鍵の組は npx web-push generate-vapid-keys で作る
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# メール（Resend）。< > を含むので引用符で囲む
RESEND_API_KEY=
EMAIL_FROM="Liveeen <liveeen@example.com>"

# BGM の曲。手元は public/bgm（deploy/bgm への印）から配る
NEXT_PUBLIC_BGM_URL=http://localhost:3000/bgm

# 本番だけ。月の上限（src/lib/view-cap.ts）
AKAMAI_API_TOKEN=
AKAMAI_REGION=
MEDIA_SERVER_FEE_USD=
YEN_PER_USD=

# 本番だけ。サーバーの誤りを Sentry に送る
SENTRY_DSN=
