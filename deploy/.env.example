# deploy/compose.yaml が読む値。サーバーの deploy/.env に写して埋める（.env はコミットしない）

# 配信サーバーのホスト名。DNS をサーバーに向けておく。Caddy がこの名前で TLS の証明書を取る
MEDIA_HOST=
# サイトの住所（https://…）。MediaMTX が配信と視聴のたびに /api/media/auth に聞く
SITE_URL=
# サイトの MEDIA_API_SECRET と同じ値（32文字以上。openssl rand -hex 32 など）
MEDIA_API_SECRET=
# サイトの COMMENT_TOKEN_SECRET と同じ値
COMMENT_TOKEN_SECRET=
