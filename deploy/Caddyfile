# 配信サーバー（Akamai）の入口。1つのホスト名で TLS を受け、中身で振り分ける。
# MediaMTX の WHIP/WHEP は終わらせるための住所（Location）を `/` から始まる形で返すので、
# 住所の頭に区切りを足して振り分けると壊れる。そのため道の形と WebSocket かどうかで振り分ける
{$MEDIA_HOST} {
	# 配信中の一覧を読む・配信を切る API。サイトだけが合言葉を付けて呼ぶ（src/lib/live.ts）
	@api path /v3/*
	handle @api {
		@authorized header Authorization "Bearer {$MEDIA_API_SECRET}"
		handle @authorized {
			reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:9997
		}
		respond 401
	}

	# コメントの中継（relay/）。`wss://…/<チャンネルの id>?token=…`
	@comments {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @comments {
		reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:8090
	}

	# 配信の縮小画像。コメントの中継が撮って返す（relay/thumbnails.ts）
	@thumbnails path /thumbnails/*
	handle @thumbnails {
		reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:8090
	}

	# ブラウザの配信に混ぜる BGM の曲（src/lib/bgm.ts）。曲はリポジトリに入れず、サーバーの deploy/bgm に置く。
	# サイトは Web Audio で曲を読むので、サイトからの読み込みを許す。許さないと無音になる
	@bgm path /bgm/*
	handle @bgm {
		header Access-Control-Allow-Origin {$SITE_URL}
		header Cache-Control "public, max-age=604800"
		root * /srv
		file_server
	}

	# ブラウザからの配信（WHIP）と低遅延の視聴（WHEP）
	@webrtc path_regexp ^/[A-Za-z0-9_-]+/wh[ie]p(/.*)?$
	handle @webrtc {
		reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:8889
	}

	# 残りは HLS
	handle {
		reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:8888
	}
}
