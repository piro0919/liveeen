{
  "name": "liveeen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --maskSecrets '**/*'",
    "typecheck": "next typegen && tsc --noEmit",
    "lefthook:install": "lefthook install",
    "test": "vitest run",
    "knip": "knip",
    "db:up": "docker compose up -d --wait",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "relay": "tsx --env-file-if-exists=.env.local relay/server.ts",
    "relay:build": "esbuild relay/server.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/relay.cjs"
  },
  "dependencies": {
    "@bprogress/next": "3.2.12",
    "@sentry/nextjs": "11.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.7",
    "botid": "1.5.11",
    "hls.js": "^1.7.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "web-push": "3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-hollow-tests": "0.3.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.7",
    "squawk-cli": "2.66.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.1.2"
}
